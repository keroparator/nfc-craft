{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ADMOB_MODE": "test"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ADMOB_MODE": "test"
      }
    },
    "play-test": {
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ADMOB_MODE": "test"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ADMOB_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
